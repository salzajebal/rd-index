# ============================================================
# VORA Markets — 환경 변수 예시
# Render 대시보드 'Environment Variables'에 아래 키를 등록하세요.
# 이 파일은 Git에 커밋되어도 안전합니다 (실제 값 없음).
# ============================================================

# [필수] Supabase PostgreSQL 접속 문자열
# Supabase 프로젝트 > Settings > Database > Connection string (URI)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# [필수] Express 세션 암호화 키 (랜덤 긴 문자열 권장)
SESSION_SECRET=your-very-long-random-secret-key-here

# [필수] 어드민 계정
ADMIN_USERNAME=your_admin_id
ADMIN_PASSWORD=your_admin_password

# [선택] GitHub Personal Access Token (DB 자동 백업 기능 사용 시)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# [자동] Render가 자동으로 주입 — 직접 설정 불필요
# PORT=10000
# NODE_ENV=production
